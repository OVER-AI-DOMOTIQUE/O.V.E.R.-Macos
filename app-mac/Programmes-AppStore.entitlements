<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Programmes rangés dans OVER.app pour l'App Store (Python, whisper-cli) : exactement ces deux droits,
	     comme Apple le demande pour un programme lancé par une application du bac à sable.
	     Ils héritent du bac à sable de l'application (et de ses droits : Internet). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
